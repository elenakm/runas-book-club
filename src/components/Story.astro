---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import elenaBg from '../assets/elena-runa-bg.png';
import elenaEn from '../assets/elena-runa-en.png';
import p1 from '../assets/story/01-books.png';
import p2 from '../assets/story/02-wrapped.png';
import p3 from '../assets/story/03-labels.png';
import p4 from '../assets/story/04-bench.png';
import p4b from '../assets/story/04b-elena-bench.png';
import p5 from '../assets/story/05-sign.png';
import p6 from '../assets/story/06-choosing.png';
import p7 from '../assets/story/07-readers.png';
import { T, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];
const bg = lang === 'bg';

const photos = [
  { src: p1, bg: 'Купчини прочетени книги върху диван', en: 'Stacks of read books on a sofa' },
  { src: p2, bg: 'Ръка държи пет книги, опаковани в кафява хартия', en: 'A hand holding five books wrapped in brown paper' },
  { src: p3, bg: 'Опаковани книги с ръкописни етикети и стикери', en: 'Wrapped books with handwritten labels and stickers' },
  { src: p4, bg: 'Пейка в парка с опаковани книги и табела „Сляпа среща с книга“', en: 'A park bench with wrapped books and a "Blind Date with a Book" sign' },
  { src: p4b, bg: 'Елена до пейката с книгите в парка', en: 'Elena next to the book bench in the park' },
  { src: p5, bg: 'Посетители разговарят до щанда с табелата', en: 'Visitors chatting by the stall and its sign' },
  { src: p6, bg: 'Читатели разглеждат опакованите книги в Морската градина', en: 'Readers browsing the wrapped books in the Sea Garden' },
  { src: p7, bg: 'Читатели избират книги на пейката в парка', en: 'Readers choosing books on the park bench' },
];

const story = bg
  ? [
      'Една събота, докато разчиствах вкъщи, ми хрумна идея: вместо просто да даря прочетените си книги, защо да не ги изпратя на среща на сляпо?',
      'Опаковах всяка в стар хартиен плик, така че корицата да не се вижда. Единствената подсказка беше ръкописен етикет, който описваше книгата съвсем бегло.',
      'На следващия ден с приятелка отидохме в парка с книгите и табела „Сляпа среща с книга“. Цена: безплатно или колкото решиш да дариш, с идеята всички дарения да отидат за благотворителност.',
      'Не очаквах нищо. За два часа повечето книги намериха нов дом, а ние събрахме 70 евро за „Спаси коте Бургас“, организация, която рехабилитира и намира дом на бездомни котенца.',
      'Книги има още много, така че следващото издание беше неизбежно. Някои от читателите дори предложиха да дарят свои книги.',
    ]
  : [
      'One Saturday, while decluttering at home, an idea showed up: instead of simply donating the books I’d read, why not send them on a blind date?',
      'I wrapped each one in an old paper bag so the cover stayed hidden. The only clue was a handwritten label vaguely describing the book.',
      'The next day, a friend and I went to the park with the books and a sign: Blind Date With a Book. Price: free, or whatever you felt like donating, with the idea that every donation would go to charity.',
      'I expected nothing. In just two hours, most of the books found new homes and we raised €70 for Save a Kitten Burgas, a local charity that helps rehabilitate and rehome stray kittens.',
      'There are plenty more books lying around, so another edition was inevitable. Some of our curious readers even offered to donate books for the next one.',
    ];
const total = String(photos.length).padStart(2, '0');
---
<Base lang={lang} page="story">
  <article class="page page-1120 story">
    <div class="intro">
      <span class="eyebrow">{t.navStory}</span>
      <h1 class="h-page">{bg ? 'Как започнахме' : 'How it all started'}</h1>
      <div class="copy">{story.map((p) => <p>{p}</p>)}</div>
    </div>

    <div class="film" aria-roledescription="carousel" aria-label={bg ? 'Снимки' : 'Photos'}>
      <div class="strip" id="strip" tabindex="0">
        {photos.map((p, i) => (
          <Image src={p.src} alt={bg ? p.bg : p.en} widths={[340, 700]} sizes="min(78vw, 340px)"
                 loading={i < 3 ? 'eager' : 'lazy'} />
        ))}
      </div>
      <div class="controls">
        <span class="count" id="strip-count" aria-live="polite">01 / {total}</span>
        <div class="arrows">
          <button type="button" id="strip-prev" aria-label={t.prevPhoto}>←</button>
          <button type="button" id="strip-next" aria-label={t.nextPhoto}>→</button>
        </div>
      </div>
    </div>

    <div class="block">
      <div class="who">
        <h2 class="h-section">{bg ? 'Кой стои зад проекта' : 'Who runs this'}</h2>
        <p class="p18" style="max-width:52ch">{bg
          ? 'Проектът е започнат от Елена Маринова, с помощта на приятели и Руна, разбира се. ;)'
          : 'Started by Elena Marinova, with help from friends and Runa, of course. ;)'}</p>
      </div>
      <div class="founder">
        <Image src={bg ? elenaBg : elenaEn} alt={bg ? 'Елена и котката Руна' : 'Elena and Runa the cat'}
               widths={[440, 880]} sizes="(max-width: 480px) calc(100vw - 40px), 440px" />
      </div>
    </div>

    <div class="block">
      <h2 class="h-section">{bg ? 'Откъде идват книгите' : 'Where the books come from'}</h2>
      <p class="p18" style="max-width:58ch">{bg
        ? 'Част от книгите са от личната библиотека на основателите. Други са дарени от наши близки и познати, а след първото издание, кръгът ни от дарители се разшири.'
        : 'Some of the books come from the founders’ own libraries. Others are donated by friends and acquaintances, and since the first edition our circle of donors has grown.'}</p>
    </div>
  </article>
</Base>

<style>
  .story { gap: clamp(48px, 6cqw, 80px); }
  .intro { display: flex; flex-direction: column; gap: 28px; }
  .copy { font-size: 19px; display: flex; flex-direction: column; gap: 18px; text-wrap: pretty; }
  .copy p { margin: 0; }

  .film { display: flex; flex-direction: column; gap: 20px; margin-top: calc(-1 * clamp(16px, 2cqw, 32px)); }
  .strip {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip :global(img) {
    flex: none; width: min(78%, 340px); height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: 3px; scroll-snap-align: start;
  }
  .controls { display: flex; justify-content: space-between; align-items: center; }
  .count { font-size: 14px; letter-spacing: .08em; font-variant-numeric: tabular-nums; }
  .arrows { display: flex; gap: 10px; }
  .arrows button {
    all: unset; box-sizing: border-box; cursor: pointer; width: 44px; height: 44px; border: 1px solid rgba(57, 63, 74, .35);
    border-radius: 50%; display: grid; place-items: center; font-size: 18px; color: var(--ink);
  }
  .arrows button:hover { background: var(--ink); color: var(--cream); }
  .arrows button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .block {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 40px;
    border-top: 1px solid var(--line-2); padding-top: 40px;
  }
  .who { display: flex; flex-direction: column; gap: 20px; }
  .p18 { margin: 0; font-size: 18px; }
  .founder { justify-self: center; width: 100%; max-width: 440px; }
  .founder :global(img) { display: block; width: 100%; height: auto; }
</style>

<script>
  const strip = document.getElementById('strip')!;
  const count = document.getElementById('strip-count')!;
  const total = strip.children.length;
  const step = () => {
    const first = strip.firstElementChild as HTMLElement | null;
    return first ? first.getBoundingClientRect().width + 16 : 356;
  };
  const pad = (n: number) => String(n).padStart(2, '0');
  let last = 0;
  strip.addEventListener('scroll', () => {
    const i = Math.min(Math.round(strip.scrollLeft / step()), total - 1);
    if (i !== last) { last = i; count.textContent = `${pad(i + 1)} / ${pad(total)}`; }
  }, { passive: true });
  const by = (d: number) => strip.scrollBy({ left: d * step(), behavior: 'smooth' });
  document.getElementById('strip-prev')!.addEventListener('click', () => by(-1));
  document.getElementById('strip-next')!.addEventListener('click', () => by(1));
</script>
